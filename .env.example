# Optional: passphrase used to encrypt private keys at rest (AES-256-GCM).
# If unset, private keys are stored in plaintext in the SQLite DB.
WALLET_MASTER_KEY=

# Optional but recommended: get a free key at https://www.trongrid.io/
TRONGRID_API_KEY=

# Optional: override the default mainnet endpoint
# TRON_FULL_HOST=https://api.trongrid.io

# Optional: host serving TronGrid's v1 REST API, used for transaction history.
# Defaults to TRON_FULL_HOST; set this if TRON_FULL_HOST is a self-hosted node.
# TRONGRID_API_HOST=https://api.trongrid.io

# Optional: Solana RPC endpoint (defaults to the rate-limited public mainnet one)
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: where the SQLite DB lives (defaults to ~/.tron-wallet-cli/wallet.db)
# WALLET_DATA_DIR=./data
